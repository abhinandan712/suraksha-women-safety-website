# Database (Use MongoDB Atlas connection string for Vercel deployment)
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/womensafety?retryWrites=true&w=majority

# Server Configuration
PORT=5001
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_here

# Groq AI
GROQ_API_KEY=your_groq_api_key_here

# Email Configuration
EMAIL=your_email@example.com
PASSWORD=your_email_app_password_here

# SMS Configuration
FAST2SMS_API_KEY=your_fast2sms_api_key_here
